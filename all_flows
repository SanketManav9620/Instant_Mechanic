## 3. Frontend Architecture (`client/`)

### 3.1 Socket Listener Hook (`client/src/hooks/useSocketEvents.ts`)

```typescript
import { useEffect, useState } from 'react';
import { useQueryClient } from '@tanstack/react-query';
import { socket } from '../lib/socket';

export const useSocketEvents = () => {
  const queryClient = useQueryClient();
  const [isConnected, setIsConnected] = useState(socket.connected);
  const [lastNotification, setLastNotification] = useState<string | null>(null);

  useEffect(() => {
    const handleConnect = () => setIsConnected(true);
    const handleDisconnect = () => setIsConnected(false);

    const handleBookingCreated = (booking: any) => {
      setLastNotification(`New Booking ${booking.bookingId} received!`);
      queryClient.invalidateQueries({ queryKey: ['bookings'] });
      queryClient.invalidateQueries({ queryKey: ['analytics'] });
      queryClient.invalidateQueries({ queryKey: ['mechanics'] });
    };

    const handleBookingUpdated = (booking: any) => {
      setLastNotification(`Booking ${booking.bookingId} status updated to ${booking.status}`);
      queryClient.invalidateQueries({ queryKey: ['bookings'] });
      queryClient.invalidateQueries({ queryKey: ['analytics'] });
      queryClient.invalidateQueries({ queryKey: ['mechanics'] });
    };

    const handleMechanicStatusChanged = (mechanic: any) => {
      setLastNotification(`Mechanic ${mechanic.name} is now ${mechanic.status}`);
      queryClient.invalidateQueries({ queryKey: ['mechanics'] });
      queryClient.invalidateQueries({ queryKey: ['analytics'] });
    };

    socket.on('connect', handleConnect);
    socket.on('disconnect', handleDisconnect);
    socket.on('booking:created', handleBookingCreated);
    socket.on('booking:updated', handleBookingUpdated);
    socket.on('mechanic:status_changed', handleMechanicStatusChanged);

    return () => {
      socket.off('connect', handleConnect);
      socket.off('disconnect', handleDisconnect);
      socket.off('booking:created', handleBookingCreated);
      socket.off('booking:updated', handleBookingUpdated);
      socket.off('mechanic:status_changed', handleMechanicStatusChanged);
    };
  }, [queryClient]);

  return { isConnected, lastNotification, clearNotification: () => setLastNotification(null) };
};
```
- **What it does:** Connects to Socket.io events and invalidates TanStack Query caches whenever backend notifications arrive.
- **Why required by system:** Replaces manual HTTP polling with automatic real-time UI synchronization.

