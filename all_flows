### 28. Analytics Aggregation Controller (`server/src/controllers/analyticsController.ts`)

```typescript
export const getAnalytics = async (req: Request, res: Response, next: NextFunction) => {
  const { days = '30' } = req.query;
  const numDays = Math.min(90, Math.max(1, parseInt(days as string, 10) || 30));

  const startDate = new Date();
  startDate.setDate(startDate.getDate() - numDays);
  startDate.setHours(0, 0, 0, 0);

  const [aggregationResult] = await Booking.aggregate([
    {
      $facet: {
        // 1. Daily booking counts and revenue
        dailyMetrics: [
          { $match: { createdAt: { $gte: startDate } } },
          {
            $group: {
              _id: { $dateToString: { format: '%Y-%m-%d', date: '$createdAt' } },
              bookings: { $sum: 1 },
              revenue: { $sum: { $cond: [{ $eq: ['$status', 'Completed'] }, '$amount', 0] } }
            }
          },
          { $sort: { _id: 1 } }
        ],

        // 2. Booking counts & revenue grouped by service category via $lookup on Service
        categoryBreakdown: [
          { $match: { createdAt: { $gte: startDate } } },
          {
            $lookup: {
              from: 'services',
              localField: 'service',
              foreignField: '_id',
              as: 'serviceDoc'
            }
          },
          { $unwind: '$serviceDoc' },
          {
            $group: {
              _id: '$serviceDoc.category',
              count: { $sum: 1 },
              revenue: { $sum: { $cond: [{ $eq: ['$status', 'Completed'] }, '$amount', 0] } }
            }
          },
          { $sort: { count: -1 } }
        ],

        // 3. Status breakdown counts for Donut chart
        statusBreakdown: [
          { $match: { createdAt: { $gte: startDate } } },
          { $group: { _id: '$status', count: { $sum: 1 } } },
          { $sort: { count: -1 } }
        ],

        // 4. Period totals
        periodSummary: [
          { $match: { createdAt: { $gte: startDate } } },
          {
            $group: {
              _id: null,
              totalBookings: { $sum: 1 },
              totalRevenue: { $sum: { $cond: [{ $eq: ['$status', 'Completed'] }, '$amount', 0] } }
            }
          }
        ]
      }
    }
  ]);
};
```

- **What it does:**
  - Evaluates operational performance over a sliding window (`7`, `30`, or `90` days).
  - Uses a single MongoDB aggregation pipeline with `$facet` to calculate four sub-pipelines in parallel:
    1. **`dailyMetrics`**: Groups bookings by day (`%Y-%m-%d`) and calculates total booking count and realized revenue (summing `amount` only when `status === 'Completed'`).
    2. **`categoryBreakdown`**: Performs a `$lookup` joining `bookings.service` with the `services` collection, unwinds the foreign document, and groups by `serviceDoc.category` to reveal which service lines (Engine, Tyres, Brakes, AC, etc.) drive the most volume and revenue.
    3. **`statusBreakdown`**: Groups bookings by status for proportional donut chart visualization.
    4. **`periodSummary`**: Computes period-level total volume and total revenue.
  - **Continuous Date Filling:** Iterates over every calendar date between `startDate` and `today`. If MongoDB returned zero bookings for any date, it fills `{ bookings: 0, revenue: 0 }`. This prevents gaps or jagged jumps in Recharts line graphs!
- **Why required:** Without `$lookup`, the `Booking` collection only has the `service` ObjectId reference. The `$lookup` joins the `Service` catalog in the database engine, allowing aggregation by `category` in sub-millisecond execution time.

